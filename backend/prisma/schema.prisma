datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum DocumentStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  RENEWAL_IN_PROGRESS
  ARCHIVED
  MISSING
}

enum ComplianceStatus {
  COMPLIANT
  PENDING
  MISSING
  EXPIRED
  UNDER_REVIEW
}

enum RenewalStatus {
  NOT_STARTED
  INITIATED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum Role {
  ADMIN
  USER
  AUDITOR
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  email      String   @unique
  password   String
  role       Role     @default(USER)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("docsafe_users")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  tenant_id   String     @db.Uuid
  name        String
  description String?
  is_active   Boolean    @default(true)
  created_by  String     @db.Uuid
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  documents   Document[]

  @@unique([tenant_id, name])
  @@map("docsafe_categories")
}

model Document {
  id               String           @id @default(uuid()) @db.Uuid
  tenant_id        String           @db.Uuid
  category_id      String           @db.Uuid
  category         Category         @relation(fields: [category_id], references: [id])
  title            String
  description      String?
  file_asset_id    String?          @db.Uuid
  owner_user_id    String?          @db.Uuid
  issue_date       DateTime
  expiry_date      DateTime
  renewal_due_date DateTime?
  status           DocumentStatus
  visibility_scope String?
  uploaded_by      String           @db.Uuid
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  compliance_items ComplianceItem[]
  renewal_records  RenewalRecord[]
  document_events  DocumentEvent[]

  @@map("docsafe_documents")
}

model ComplianceItem {
  id                 String           @id @default(uuid()) @db.Uuid
  tenant_id          String           @db.Uuid
  name               String
  category_id        String?          @db.Uuid
  linked_document_id String?          @db.Uuid
  linked_document    Document?        @relation(fields: [linked_document_id], references: [id])
  due_date           DateTime?
  severity           String
  status             ComplianceStatus
  notes              String?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  @@map("docsafe_compliance_items")
}

model RenewalRecord {
  id           String        @id @default(uuid()) @db.Uuid
  tenant_id    String        @db.Uuid
  document_id  String        @db.Uuid
  document     Document      @relation(fields: [document_id], references: [id])
  initiated_by String        @db.Uuid
  initiated_at DateTime
  stage        String
  remarks      String?
  completed_at DateTime?
  status       RenewalStatus
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  @@map("docsafe_renewal_records")
}

model DocumentEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  document_id  String   @db.Uuid
  document     Document @relation(fields: [document_id], references: [id])
  event_type   String
  payload_json Json?
  triggered_by String?  @db.Uuid
  triggered_at DateTime @default(now())

  @@map("docsafe_document_events")
}
